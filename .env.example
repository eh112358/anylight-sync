# AnyList credentials
ANYLIST_EMAIL=your@email.com
ANYLIST_PASSWORD=yourpassword

# Skylight credentials
SKYLIGHT_EMAIL=your@email.com
SKYLIGHT_PASSWORD=yourpassword
SKYLIGHT_FRAME_ID=abc123

# List sync config
# Comma-separated pairs: AnyList list name = Skylight list name
# Example: "Grocery List=Grocery List,Hardware=Hardware List"
LIST_SYNC_PAIRS=Grocery List=Grocery List

# How often to poll Skylight for changes (milliseconds)
SYNC_INTERVAL_MS=60000

# Timezone for meal planning date handling
TIMEZONE=America/New_York

# Optional: log level (debug | info | warn | error)
LOG_LEVEL=info

# Optional: path to the SQLite database file
# In Kubernetes, this should be on a persistent volume
STATE_DB_PATH=/data/sync-state.db
